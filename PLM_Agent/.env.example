# Direct OpenAI (used when COORDINATOR_CHOICE="gpt-5.1")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3.8:27b

# Local retrieval-context scoring
PLM_RCS_MODEL=qwen2.5:7b

# Atomic metadata chunking
RAG_ATOMIC_TOKENS=180
RAG_ATOMIC_OVERLAP=60
RAG_CHUNK_ENCODING=cl100k_base

# Project root for artifact resolution
PLM_PROJECT_ROOT=/absolute/path/to/NEHM_Stable
PLM_OPENAI_TIMEOUT_SECONDS=180
PLM_OPENAI_MAX_RETRIES=2
