# Direct OpenAI (used when COORDINATOR_CHOICE="gpt-5.1")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3.8:27b

# Local retrieval-context scoring
PLM_RCS_MODEL=qwen2.5:7b

# Atomic metadata chunking
RAG_ATOMIC_TOKENS=180
RAG_ATOMIC_OVERLAP=60
RAG_CHUNK_ENCODING=cl100k_base

# Local arbitrary-image web app
PLM_PROJECT_ROOT=/absolute/path/to/NEHM_Stable
PLM_WEB_DATA_DIR=/absolute/path/to/NEHM_Stable/NEHM_RESULTS/plm_web
PLM_WEB_MAX_UPLOAD_MB=25
PLM_WEB_RESULT_TTL_SECONDS=86400
PLM_WEB_MAX_QUEUE_SIZE=10
PLM_WEB_JOB_TIMEOUT_SECONDS=1800
PLM_WEB_MAX_IMAGE_PIXELS=80000000
PLM_WEB_PUBLIC_PROTOTYPE=false
PLM_WEB_HOST=127.0.0.1
PLM_WEB_PORT=8080
PLM_OPENAI_TIMEOUT_SECONDS=180
PLM_OPENAI_MAX_RETRIES=2
