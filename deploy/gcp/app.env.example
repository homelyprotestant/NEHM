# Copy to app.env for the one-time secure setup transfer, or edit
# /opt/plm-agent/secrets/app.env directly on the VM. Never commit app.env.
OPENAI_API_KEY=

# Public HTTP/IP prototype limits and persistent job data.
PLM_WEB_MAX_UPLOAD_MB=25
PLM_WEB_RESULT_TTL_SECONDS=86400
PLM_WEB_MAX_QUEUE_SIZE=10
PLM_WEB_JOB_TIMEOUT_SECONDS=1800
PLM_WEB_MAX_IMAGE_PIXELS=80000000
PLM_OPENAI_TIMEOUT_SECONDS=180
PLM_OPENAI_MAX_RETRIES=2
